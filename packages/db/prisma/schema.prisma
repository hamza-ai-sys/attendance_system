generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NoteVisibility {
  PUBLIC
  PRIVATE
}

enum AccrualFrequency {
  MONTHLY
  ANNUALLY
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  DISABLED
  OFFLINE
}

enum DeviceMode {
  SCAN
  ENROLL
}

enum EnrollmentSessionStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum FingerprintEnrollmentStatus {
  ACTIVE
  REVOKED
}

enum ManualAttendanceRequestType {
  ADD_SCAN
  REMOVE_SCAN
}

enum ManualAttendanceRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApproverKind {
  MANAGER
  HR
  OWNER
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_REMINDER
  ATTENDANCE_ANOMALY
  DEVICE_OFFLINE
  ENROLLMENT_FAILED
  REPORT_READY
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Employee {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  employeeCode         String?                   @unique
  fullName             String
  passwordHash         String
  status               EmployeeStatus            @default(ACTIVE)
  supervisorId         String?                   @map("managerId")
  roleId               String?
  shiftInTime          String?                   @default("09:00")
  shiftOutTime         String?                   @default("17:00")
  timezone              String                    @default("Asia/Karachi")
  phone                 String?
  dateOfBirth           String?
  gender                String?
  maritalStatus         String?
  currentAddress        String?
  permanentAddress      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  role                 Role?                     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  supervisor           Employee?                 @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports        Employee[]                @relation("EmployeeSupervisor")
  approvalSteps        ApprovalStep[]            @relation("ApprovalStepApprover")
  auditLogs            AuditLog[]                @relation("AuditLogActor")
  fingerprintRecords   FingerprintEnrollment[]
  requestedEnrollments EnrollmentSession[]       @relation("EnrollmentRequestedBy")
  enrollmentSessions   EnrollmentSession[]
  manualRequests       ManualAttendanceRequest[] @relation("ManualRequestEmployee")
  createdRequests      ManualAttendanceRequest[] @relation("ManualRequestCreatedBy")
  notifications        Notification[]
  reportExports        ReportExport[]
  scanEvents           ScanEvent[]
  shiftAssignments     EmployeeShiftAssignment[]
  leaveRequests        LeaveRequest[]            @relation("LeaveRequestEmployee")
  leaveApprovalSteps   LeaveApprovalStep[]       @relation("LeaveApprovalStepApprover")
  leaveBalances        LeaveBalance[]
  targetNotes          EmployeeNote[]            @relation("NoteTargetEmployee")
  authoredNotes        EmployeeNote[]            @relation("NoteAuthor")
  createdTemplates     PerformanceTemplate[]     @relation("PerformanceTemplateCreator")
  receivedEvaluations  PerformanceEvaluation[]   @relation("PerformanceTargetEmployee")
  submittedEvaluations PerformanceEvaluation[]   @relation("PerformanceEvaluator")

  @@index([supervisorId])
}

model Device {
  id                     String                  @id @default(cuid())
  name                   String
  location               String?
  apiKeyHash             String
  status                 DeviceStatus            @default(ACTIVE)
  reportedMode           DeviceMode              @default(SCAN)
  modeChangedAt          DateTime                @default(now())
  firmwareVersion        String?
  lastSeenAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  enrollmentSessions     EnrollmentSession[]
  fingerprintEnrollments FingerprintEnrollment[]
  scanEvents             ScanEvent[]

  @@index([status, lastSeenAt])
}

model FingerprintEnrollment {
  id                String                      @id @default(cuid())
  employeeId        String
  deviceId          String
  scannerTemplateId Int
  status            FingerprintEnrollmentStatus @default(ACTIVE)
  enrolledAt        DateTime                    @default(now())
  revokedAt         DateTime?
  device            Device                      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee          Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, scannerTemplateId])
  @@unique([employeeId, deviceId])
}

model EnrollmentSession {
  id                    String                  @id @default(cuid())
  employeeId            String
  deviceId              String
  requestedByEmployeeId String
  scannerTemplateId     Int?
  status                EnrollmentSessionStatus @default(PENDING)
  errorMessage          String?
  expiresAt             DateTime
  claimedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  device                Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee              Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy           Employee                @relation("EnrollmentRequestedBy", fields: [requestedByEmployeeId], references: [id])

  @@index([deviceId, status, expiresAt])
  @@index([employeeId, status])
}

model ScanEvent {
  id                 String                    @id @default(cuid())
  deviceId           String
  employeeId         String?
  scannerTemplateId  Int
  deviceScanSequence Int?
  firmwareVersion    String?
  matchConfidence    Decimal?                  @db.Decimal(5, 4)
  rawPayload         Json?
  serverReceivedAt   DateTime                  @default(now())
  createdAt          DateTime                  @default(now())
  removedByRequests  ManualAttendanceRequest[] @relation("RemovedScan")
  device             Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee           Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceScanSequence])
  @@index([employeeId, serverReceivedAt])
  @@index([deviceId, serverReceivedAt])
}

model Shift {
  id           String                    @id @default(cuid())
  name         String
  timezone     String                    @default("Asia/Karachi")
  startTime    String
  endTime      String
  workdays     Int[]
  graceMinutes Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  assignments  EmployeeShiftAssignment[]
}

model EmployeeShiftAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  shiftId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom, effectiveTo])
}

model ManualAttendanceRequest {
  id                  String                        @id @default(cuid())
  employeeId          String
  createdByEmployeeId String
  type                ManualAttendanceRequestType
  requestedTimestamp  DateTime?
  targetScanEventId   String?
  reason              String
  status              ManualAttendanceRequestStatus @default(PENDING_MANAGER)
  appliedAt           DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  approvalSteps       ApprovalStep[]
  createdBy           Employee                      @relation("ManualRequestCreatedBy", fields: [createdByEmployeeId], references: [id])
  employee            Employee                      @relation("ManualRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  targetScanEvent     ScanEvent?                    @relation("RemovedScan", fields: [targetScanEventId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
}

model ApprovalStep {
  id                        String                  @id @default(cuid())
  manualAttendanceRequestId String
  sequence                  Int
  approverEmployeeId        String
  approverKind              ApproverKind
  status                    ApprovalStatus          @default(PENDING)
  comment                   String?
  decidedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  approver                  Employee                @relation("ApprovalStepApprover", fields: [approverEmployeeId], references: [id], onDelete: Cascade)
  manualAttendanceRequest   ManualAttendanceRequest @relation(fields: [manualAttendanceRequestId], references: [id], onDelete: Cascade)

  @@unique([manualAttendanceRequestId, sequence])
  @@index([approverEmployeeId, status])
}

model Notification {
  id         String             @id @default(cuid())
  employeeId String
  type       NotificationType
  status     NotificationStatus @default(UNREAD)
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status, createdAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())
  actor      Employee? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  details    Json?

  @@index([jobName, startedAt])
}

model ReportExport {
  id            String             @id @default(cuid())
  requestedById String
  name          String
  status        ReportExportStatus @default(PENDING)
  parameters    Json
  filePath      String?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?
  requestedBy   Employee           @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  employees   Employee[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanySetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LeaveTypeConfig {
  id                  String           @id @default(cuid())
  code                String           @unique
  name                String
  description         String?
  accrualFrequency    AccrualFrequency @default(ANNUALLY)
  defaultAllocation   Float            @default(0)
  allowCarryForward   Boolean          @default(false)
  maxCarryForwardDays Float            @default(0)
  isPaid              Boolean          @default(true)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
}

model LeaveRequest {
  id              String              @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  paidDays        Float?              @default(0)
  unpaidDays      Float?              @default(0)
  reason          String
  status          LeaveRequestStatus  @default(PENDING_MANAGER)
  rejectionReason String?
  appliedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  employee        Employee            @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveTypeConfig     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvalSteps   LeaveApprovalStep[]

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
}

model LeaveApprovalStep {
  id                 String         @id @default(cuid())
  leaveRequestId     String
  sequence           Int
  approverEmployeeId String
  approverKind       ApproverKind
  status             ApprovalStatus @default(PENDING)
  comment            String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())
  approver           Employee       @relation("LeaveApprovalStepApprover", fields: [approverEmployeeId], references: [id], onDelete: Cascade)
  leaveRequest       LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, sequence])
  @@index([approverEmployeeId, status])
}

model LeaveBalance {
  id          String          @id @default(cuid())
  employeeId  String
  year        Int
  leaveTypeId String
  allocated   Float           @default(0)
  accrued     Float           @default(0)
  used        Float           @default(0)
  carriedOver Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveTypeId])
  @@index([employeeId, year])
}

model EmployeeNote {
  id         String         @id @default(cuid())
  employeeId String
  authorId   String
  content    String
  visibility NoteVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  employee   Employee       @relation("NoteTargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author     Employee       @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([employeeId, visibility])
  @@index([authorId])
}

model PerformanceTemplate {
  id          String                  @id @default(cuid())
  title       String
  description String?
  fields      Json
  startDate   DateTime
  endDate     DateTime
  createdById String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  createdBy   Employee                @relation("PerformanceTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  evaluations PerformanceEvaluation[]

  @@index([startDate, endDate])
}

model PerformanceEvaluation {
  id           String              @id @default(cuid())
  templateId   String
  employeeId   String
  evaluatorId  String
  responses    Json
  overallScore Float?
  comments     String?
  submittedAt  DateTime            @default(now())
  template     PerformanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee     Employee            @relation("PerformanceTargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  evaluator    Employee            @relation("PerformanceEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([templateId, employeeId, evaluatorId])
  @@index([employeeId])
  @@index([evaluatorId])
}

